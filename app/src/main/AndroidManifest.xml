<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Playlists are fetched over the network and the pairing page is served on the LAN. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Prism, the assistant, listens through the remote's microphone; asked only the first time Prism is used. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android TV / Google TV: remote-controlled, no touchscreen required. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Needed on Android 11+ to see which launcher apps are installed (the Shortcuts page). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Prism's ears and voice: the speech recogniser and the text-to-speech engine of the TV. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- Cleartext is allowed because many playlist and stream hosts are plain http. Pairing runs over local http too (see README, Security). -->
    <application
        android:name=".PrismApp"
        android:allowBackup="false"
        android:largeHeap="true"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PrismPlayer"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode|smallestScreenSize|screenLayout"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
